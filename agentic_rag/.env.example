# .env.example
# Copy to .env and fill in your values

# ── Google / Gemini API ──────────────────────────────────────────────
# GOOGLE_API_KEY is used by langchain-google-genai (ChatGoogleGenerativeAI, GoogleGenerativeAIEmbeddings)
# GEMINI_API_KEY  is used by the google-generativeai SDK directly (VLM OCR, image description)
# Both are required — set them to the same key.
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-google-api-key-here

# ── Reranker (post-retrieval relevance scoring) ───────────────────────
# RERANKER_BACKEND=gemini (default, uses GOOGLE_API_KEY) or ollama (local)
# Connection refused on ollama usually means Ollama is not running — use gemini.
RERANKER_BACKEND=gemini
# Use gemini-2.5-flash for stability; flash-lite is cheaper but often 503 under load
RERANKER_MODEL=gemini-2.5-flash-lite

# ── Ollama (only if RERANKER_BACKEND=ollama) ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Index Directory (SQLite + logs) ──────────────────────────────────
INDEX_DIR=./index_data

# ── Models (override defaults) ───────────────────────────────────────
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Optional: cheaper/faster reranker, e.g. gemini-2.0-flash-lite
# RERANKER_MODEL=gemini-2.0-flash-lite
EMBEDDING_DIM=768

# ── VLM (PDF/DOCX image OCR) ─────────────────────────────────────────
# VLM_ENABLED=false disables all Gemini vision calls.
# When true, pages with enough extracted text skip VLM (text-native PDFs).
VLM_ENABLED=true
VLM_TEXT_DENSITY_THRESHOLD=500

# ── Chunking strategy ──────────────────────────────────────────────────
# USE_MAXMIN_CHUNKING=false (default): LLM agentic chunking (higher quality, slower/costlier)
# USE_MAXMIN_CHUNKING=true: Max-Min semantic chunking (embed sentences, no generation)
USE_MAXMIN_CHUNKING=false
MAXMIN_HARD_THRESHOLD=0.6
MAXMIN_C=0.9
MAXMIN_INIT_CONSTANT=1.5
MAXMIN_MAX_CHUNK_CHARS=2000
MAXMIN_EMBED_BATCH_SIZE=64

# ── Flask Web UI ─────────────────────────────────────────────────────
# Set FRONTEND=true to enable the web UI (python app.py)
FRONTEND=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
